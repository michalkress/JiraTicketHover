<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ComboBoxPopupBackgroundGradientBrushKey}}"
            TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
            Padding="4">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="2"
                            Padding="8,4"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}"
                            Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Url}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Key}"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}"
                                       Opacity="0.85" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</DataTemplate>
